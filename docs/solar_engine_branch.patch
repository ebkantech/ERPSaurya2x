+# --- Build lifecycle ------------------------------------------------------
+BUILD_DRAFT = 'draft'
+BUILD_LOCKED = 'locked'
+BUILD_IN_EXECUTION = 'in_execution'
+BUILD_COMPLETED = 'completed'
+BUILD_STATUS_CHOICES = [
+    (BUILD_DRAFT, 'Draft'),
+    (BUILD_LOCKED, 'Locked'),
+    (BUILD_IN_EXECUTION, 'In Execution'),
+    (BUILD_COMPLETED, 'Completed'),
+]
